<%# The checkboxes are rendered by the FeaturableCollections Vue component %>
<featurable-collections
  input-name="<%= "#{f.object_name}[featurable][]" %>"
  collection-select=".member-of-collection-ids"
  label="<%= t("simple_form.labels.defaults.featurable") %>"
  empty-message="Add this resource to a collection to make it available for highlighting."
  :selected="<%= Array.wrap(f.object.featurable).map(&:to_s).to_json %>"
  :options="<%= f.object.featurable_options.to_json %>"
></featurable-collections>
